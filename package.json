{
  "name": "dsh-connect-zcode",
  "version": "0.8.0",
  "description": "把本机 ZCode 桌面客户端的模型接入 DeepSeek​ Harness：自动发现客户端安装与数据目录，按客户端自己的方式启动内置 agent，注册编码套餐路由，并支持逐模型启用/停用。",
  "license": "AGPL-3.0",
  "author": "kyle123740",
  "contributors": [
    "tangyixiao",
    "shudaozhang"
  ],
  "homepage": "https://github.com/shudaozhang/dsh-connect-zcode#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shudaozhang/dsh-connect-zcode.git"
  },
  "bugs": {
    "url": "https://github.com/shudaozhang/dsh-connect-zcode/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "zcode",
    "glm",
    "zai",
    "model-provider",
    "desktop-client"
  ],
  "type": "module",
  "main": "lib/index.js",
  "bin": {
    "dsh-connect-zcode": "bin/dsh-connect-zcode.js"
  },
  "scripts": {
    "test": "node --test",
    "typecheck": "tsc -p tsconfig.json",
    "diagnose": "node bin/dsh-connect-zcode.js"
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./client-signing": "./lib/client-signing.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "dependencies": {},
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5.0.0 || 4.0.1-rc.1 || 4.0.1-rc.4 || 4.0.5-alpha.1 || 4.0.5-alpha.2",
    "@deepseek-ai/schemastery": ">=3.18.1 <4.0.0 || 3.18.1-rc.1 || 3.18.1-rc.4 || 3.18.5-alpha.1 || 3.18.5-alpha.2",
    "@deepseek-ai/dsh-llm": ">=0.1.5 <0.3.0-0 || 0.1.5-rc.1 || 0.1.5-rc.2 || 0.1.5-rc.3 || 0.1.7-rc.1 || 0.1.7-rc.2 || 0.2.0-rc.1 || 0.2.0-rc.2 || 0.2.1-rc.1 || 0.2.1-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-attachment": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.5",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "lib",
    "bin",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ]
}

